<UserControl x:Class="DNS_Forge_Client.Pages.AdapterSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DNS_Forge_Client.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="Black"/>
                <GradientStop Color="#FF111318" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid Height="40"
            Background="#181818"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Margin="0,0,0,410"/>
        <Label Content="DNS Forge" HorizontalAlignment="Center" VerticalAlignment="Top" Height="40" Width="150" FontSize="24" Foreground="White" FontFamily="Arial Black" MouseDown="Label_MouseDown"/>
        <Button Content="X"
            Margin="749,0,0,410"
            Click="Button_Click"
            FontSize="24"
            FontWeight="Bold"
            Foreground="#FF35D6C5"
            Background="Transparent"
            BorderThickness="0"
            Padding="0">

            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#FF3A2020"/>
                            <Setter Property="Foreground"
                                Value="#FFFF5555"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Button Content="—"
            Margin="698,0,51,410"
            Click="Button1_Click"
            FontSize="24"
            FontWeight="Bold"
            Foreground="#FF35D6C5"
            Background="Transparent"
            BorderThickness="0"
            Padding="0">

            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#FF303030"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Button Content="X"
            Margin="749,0,0,410"
            Click="Button_Click"
            FontSize="24"
            FontWeight="Bold"
            Foreground="#FF35D6C5"
            Background="Transparent"
            BorderThickness="0"
            Padding="0">

            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#FF3A2020"/>
                            <Setter Property="Foreground"
                                Value="#FFFF5555"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Button Content="&lt;"
            Margin="0,0,749,410"
            Click="Button2_Click"
            FontSize="24"
            FontWeight="Bold"
            Foreground="#FF35D6C5"
            Background="Transparent"
            BorderThickness="0"
            Padding="0">

            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#FF303030"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <ListBox x:Name="listBox"
         d:ItemsSource="{d:SampleData ItemCount=5}"
         Margin="0,45,0,0"
         BorderBrush="{x:Null}"
         SelectionChanged="ListBox_SelectionChanged"
         Foreground="White"
         FontWeight="Bold" FontSize="16" MouseDoubleClick="listBox_MouseDoubleClick">
            <ListBox.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="#FF111318" Offset="1"/>
                </LinearGradientBrush>
            </ListBox.Background>
        </ListBox>
        <Label Content="Alpha 1.0" HorizontalAlignment="Center" Margin="0,412,0,0" VerticalAlignment="Top" Width="66" Height="28" Foreground="#FF565252" FontWeight="Bold"/>

    </Grid>
</UserControl>
