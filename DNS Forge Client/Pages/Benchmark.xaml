<UserControl x:Class="DNS_Forge_Client.Pages.Benchmark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DNS_Forge_Client.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="Black"/>
            <GradientStop Color="#FF111318" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Background>
    <Grid>
        <Grid Height="40"
            Background="#181818"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Margin="0,0,0,410"/>
        <Label Content="DNS Forge" HorizontalAlignment="Center" VerticalAlignment="Top" Height="40" Width="150" FontSize="24" Foreground="White" FontFamily="Arial Black" MouseDown="Label_MouseDown"/>
        <Button Content="X"
            Margin="749,0,0,410"
            Click="Button_Click"
            FontSize="24"
            FontWeight="Bold"
            Foreground="#FF35D6C5"
            Background="Transparent"
            BorderThickness="0"
            Padding="0">

            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#FF3A2020"/>
                            <Setter Property="Foreground"
                                Value="#FFFF5555"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Button Content="—"
            Margin="698,0,51,410"
            Click="Button1_Click"
            FontSize="24"
            FontWeight="Bold"
            Foreground="#FF35D6C5"
            Background="Transparent"
            BorderThickness="0"
            Padding="0">

            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#FF303030"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Button Content="X"
            Margin="749,0,0,410"
            Click="Button_Click"
            FontSize="24"
            FontWeight="Bold"
            Foreground="#FF35D6C5"
            Background="Transparent"
            BorderThickness="0"
            Padding="0">

            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#FF3A2020"/>
                            <Setter Property="Foreground"
                                Value="#FFFF5555"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Button Content="&lt;"
            Margin="0,0,749,410"
            Click="Button2_Click"
            FontSize="24"
            FontWeight="Bold"
            Foreground="#FF35D6C5"
            Background="Transparent"
            BorderThickness="0"
            Padding="0">

            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#FF303030"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Label Content="Alpha 1.0" HorizontalAlignment="Center" Margin="0,412,0,0" VerticalAlignment="Top" Width="66" Height="28" Foreground="#FF565252" FontWeight="Bold"/>

        <DataGrid x:Name="BenchmarkTable"
          Margin="0,45,0,0"
          Background="#111318"
          Foreground="#E5E7EB"
          BorderThickness="0"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          CanUserAddRows="False"
          CanUserResizeRows="False"
          CanUserReorderColumns="False"
          SelectionUnit="FullRow"
          SelectionMode="Single"
          HeadersVisibility="Column"
          GridLinesVisibility="Horizontal"
          HorizontalGridLinesBrush="#2A303A"
          VerticalGridLinesBrush="Transparent"
          RowBackground="#181B22"
          AlternatingRowBackground="#1D212A"
          AlternationCount="2"
          RowHeight="44"
          ColumnHeaderHeight="42"
          FontSize="13"
          FocusVisualStyle="{x:Null}"
          SnapsToDevicePixels="True"
          SelectionChanged="DataGrid_SelectionChanged_1">

            <DataGrid.Resources>

                <!-- Column Headers -->
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="Background" Value="#20252E"/>
                    <Setter Property="Foreground" Value="#9CA3AF"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="#303641"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                </Style>

                <!-- Rows -->
                <Style TargetType="{x:Type DataGridRow}">
                    <Setter Property="Height" Value="44"/>
                    <Setter Property="MinHeight" Value="44"/>
                    <Setter Property="MaxHeight" Value="44"/>
                    <Setter Property="Foreground" Value="#E5E7EB"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="SnapsToDevicePixels" Value="True"/>

                    <Style.Triggers>
                        <Trigger Property="AlternationIndex" Value="1">
                            <Setter Property="Background" Value="#1D212A"/>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#292F39"/>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#233B3D"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <!-- Cells -->
                <Style TargetType="{x:Type DataGridCell}">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Foreground" Value="#E5E7EB"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="SnapsToDevicePixels" Value="True"/>

                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <!-- Text inside cells -->
                <Style x:Key="CenteredCellText"
               TargetType="{x:Type TextBlock}">
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="TextAlignment" Value="Center"/>
                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    <Setter Property="Margin" Value="8,0"/>
                </Style>

                <!-- Scrollbar -->
                <Style TargetType="{x:Type ScrollBar}">
                    <Setter Property="Background" Value="#111318"/>
                </Style>

            </DataGrid.Resources>

            <DataGrid.Columns>

                <DataGridTextColumn Header="DNS Name"
                            Binding="{Binding Name}"
                            Width="*"
                            IsReadOnly="True"
                            ElementStyle="{StaticResource CenteredCellText}"/>

                <DataGridTextColumn Header="Availability"
                            Binding="{Binding Availability}"
                            Width="*"
                            IsReadOnly="True"
                            ElementStyle="{StaticResource CenteredCellText}"/>

                <DataGridTextColumn Header="Latency (s)"
                            Binding="{Binding Latency, StringFormat={}{0:F2}}"
                            Width="*"
                            IsReadOnly="True"
                            ElementStyle="{StaticResource CenteredCellText}"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>
</UserControl>
